  "sections": [
    {"id": 1, "title": "工作节奏", "subtitle": "请根据你通常的工作表现作答", "question_ids": ["Q01", "Q02", "Q03", "Q04", "Q05", "Q06", "Q07", "Q08"]},
    {"id": 2, "title": "协作方式", "subtitle": "答案没有好坏，请选择最接近真实情况的一项", "question_ids": ["Q09", "Q10", "Q11", "Q12", "Q13", "Q14", "Q15", "Q16"]},
    {"id": 3, "title": "变化与学习", "subtitle": "请不要按照理想状态作答", "question_ids": ["Q17", "Q18", "Q19", "Q20", "Q21", "Q22", "Q23", "Q24"]},
