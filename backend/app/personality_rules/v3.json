    {"id": "C04", "kind": "credibility", "response_type": "likert6", "dimension": "可信度", "direction": "positive", "check_type": "consistency", "compare_question_id": "P17", "compare_direction": "reverse", "prompt": "即使已有可用办法，我也常想看看是否存在新的可能。"}
