    {"id": "P01", "kind": "personality", "response_type": "likert6", "dimension": "宜人性", "direction": "positive", "norm_core": true, "prompt": "我觉得大部分人基本上是心怀善意的。"},
    {"id": "P02", "kind": "personality", "response_type": "likert6", "dimension": "外向性", "direction": "reverse", "norm_core": true, "prompt": "我对人多的聚会感到乏味。"},
    {"id": "P03", "kind": "personality", "response_type": "likert6", "dimension": "开放性", "direction": "positive", "norm_core": true, "prompt": "我是个勇于冒险、突破常规的人。"},
    {"id": "P04", "kind": "personality", "response_type": "likert6", "dimension": "开放性", "direction": "positive", "norm_core": true, "prompt": "我喜欢冒险。"},
    {"id": "P05", "kind": "personality", "response_type": "likert6", "dimension": "外向性", "direction": "reverse", "norm_core": true, "prompt": "我尽量避免参加人多的聚会和嘈杂的环境。"},
    {"id": "P06", "kind": "personality", "response_type": "likert6", "dimension": "尽责性", "direction": "positive", "norm_core": true, "prompt": "我喜欢一开头就把事情计划好。"},
    {"id": "P07", "kind": "personality", "response_type": "likert6", "dimension": "开放性", "direction": "positive", "norm_core": true, "prompt": "我身上具有别人没有的冒险精神。"},
    {"id": "P08", "kind": "personality", "response_type": "likert6", "dimension": "宜人性", "direction": "positive", "norm_core": true, "prompt": "虽然社会上有些骗子，但我觉得大部分人还是可信的。"},
    {"id": "P09", "kind": "personality", "response_type": "likert6", "dimension": "尽责性", "direction": "positive", "norm_core": true, "prompt": "我工作或学习很勤奋。"},
    {"id": "P10", "kind": "personality", "response_type": "likert6", "dimension": "情绪稳定性", "direction": "reverse", "norm_core": true, "prompt": "我常担忧一些无关紧要的事情。"},
    {"id": "P11", "kind": "personality", "response_type": "likert6", "dimension": "情绪稳定性", "direction": "reverse", "norm_core": true, "prompt": "我常常感到内心不踏实。"},
    {"id": "P12", "kind": "personality", "response_type": "likert6", "dimension": "情绪稳定性", "direction": "reverse", "norm_core": true, "prompt": "我常担心有什么不好的事情要发生。"},
    {"id": "P13", "kind": "personality", "response_type": "likert6", "dimension": "宜人性", "direction": "positive", "norm_core": true, "prompt": "尽管社会存在一些阴暗面，我仍相信人性总的来说是善良的。"},
    {"id": "P14", "kind": "personality", "response_type": "likert6", "dimension": "外向性", "direction": "positive", "norm_core": true, "prompt": "我喜欢参加社交与娱乐聚会。"},
    {"id": "P15", "kind": "personality", "response_type": "likert6", "dimension": "尽责性", "direction": "positive", "norm_core": true, "prompt": "做事讲究逻辑和条理是我的一个特点。"},

    {"id": "P16", "kind": "personality_context", "response_type": "likert6", "dimension": "开放性", "direction": "positive", "prompt": "面对一个熟悉的问题，我会有兴趣试试与惯常做法不同的解释。"},
    {"id": "P17", "kind": "personality_context", "response_type": "likert6", "dimension": "开放性", "direction": "reverse", "prompt": "如果现有办法还能用，我通常不太想为新的可能性分散注意力。"},
    {"id": "P18", "kind": "personality_context", "response_type": "likert6", "dimension": "开放性", "direction": "positive", "prompt": "我容易被跨领域的观点吸引，即使它暂时与工作无关。"},
    {"id": "P19", "kind": "personality_context", "response_type": "likert6", "dimension": "尽责性", "direction": "positive", "prompt": "任务还很模糊时，我倾向先搭一个可调整的结构再开始。"},
    {"id": "P20", "kind": "personality_context", "response_type": "likert6", "dimension": "尽责性", "direction": "reverse", "prompt": "临近期限带来的压力，常常比提前安排更能让我进入状态。"},
    {"id": "P21", "kind": "personality_context", "response_type": "likert6", "dimension": "尽责性", "direction": "positive", "prompt": "完成主要部分后，我通常还会留意容易被忽略的收尾事项。"},
    {"id": "P22", "kind": "personality_context", "response_type": "likert6", "dimension": "外向性", "direction": "positive", "prompt": "讨论刚开始时，我往往愿意先抛出一个不成熟的想法。"},
    {"id": "P23", "kind": "personality_context", "response_type": "likert6", "dimension": "外向性", "direction": "reverse", "prompt": "长时间与多人互动后，我通常需要独处才能恢复精力。"},
    {"id": "P24", "kind": "personality_context", "response_type": "likert6", "dimension": "外向性", "direction": "positive", "prompt": "进入陌生群体时，我一般不会等很久才开始交流。"},
    {"id": "P25", "kind": "personality_context", "response_type": "likert6", "dimension": "宜人性", "direction": "positive", "prompt": "分歧发生时，我会自然地先理解对方为什么那样判断。"},
    {"id": "P26", "kind": "personality_context", "response_type": "likert6", "dimension": "宜人性", "direction": "reverse", "prompt": "当结论很重要时，我不太介意让讨论显得尖锐。"},
    {"id": "P27", "kind": "personality_context", "response_type": "likert6", "dimension": "宜人性", "direction": "positive", "prompt": "即使别人表达得不够好，我也会尝试找出其中合理的部分。"},
    {"id": "P28", "kind": "personality_context", "response_type": "likert6", "dimension": "情绪稳定性", "direction": "positive", "prompt": "计划突然改变时，我通常能较快把注意力转到下一步。"},
    {"id": "P29", "kind": "personality_context", "response_type": "likert6", "dimension": "情绪稳定性", "direction": "reverse", "prompt": "一次不顺利的互动，容易在之后很久占据我的注意力。"},
    {"id": "P30", "kind": "personality_context", "response_type": "likert6", "dimension": "情绪稳定性", "direction": "positive", "prompt": "信息不完整时，我通常可以先保留判断，而不是反复设想最坏结果。"},

    {"id": "L01", "kind": "workplace_likert", "response_type": "likert6", "dimension": "长期投入", "direction": "positive", "source_marker": "color", "prompt": "一份工作琐事多、回报周期长，我愿意长期坚持。"},
    {"id": "L02", "kind": "workplace_likert", "response_type": "likert6", "dimension": "长期投入", "direction": "reverse", "source_marker": "color", "prompt": "如果一份工作每天重复相同基础事务，我很难长期保持稳定状态。"},
    {"id": "L03", "kind": "workplace_likert", "response_type": "likert6", "dimension": "诚信履约", "direction": "positive", "source_marker": "color", "prompt": "和外部合作方沟通时，我习惯客观描述现状，不会刻意放大优势促成合作。"},
    {"id": "L04", "kind": "workplace_likert", "response_type": "likert6", "dimension": "节奏适应", "direction": "reverse", "source_marker": "leading_space", "prompt": "不用额外承担临时任务、流程固定轻松的岗位，会是我的优先选择。"},
    {"id": "L05", "kind": "workplace_likert", "response_type": "likert6", "dimension": "节奏适应", "direction": "positive", "source_marker": "leading_space", "prompt": "团队人手紧张时，我会主动分担不属于本职的临时工作。"},
    {"id": "L06", "kind": "workplace_likert", "response_type": "likert6", "dimension": "专业成长", "direction": "positive", "source_marker": "leading_space", "prompt": "想要弄清业务真实问题，我更倾向亲自到现场了解，而非只看他人转述信息。"},
    {"id": "L07", "kind": "workplace_likert", "response_type": "likert6", "dimension": "专业成长", "direction": "reverse", "source_marker": "leading_space", "prompt": "完成当日既定工作后，我很少主动梳理优化现有工作方法。"},
    {"id": "L08", "kind": "workplace_likert", "response_type": "likert6", "dimension": "客户意识", "direction": "reverse", "source_marker": "leading_space", "prompt": "对接人提出超出常规范围的诉求、情绪急躁时，我容易失去耐心。"},
    {"id": "L09", "kind": "workplace_likert", "response_type": "likert6", "dimension": "客户意识", "direction": "reverse", "source_marker": "leading_space", "prompt": "完成岗位规定基础工作后，我不会主动提供额外协助。"},
    {"id": "L10", "kind": "workplace_likert", "response_type": "likert6", "dimension": "协作共益", "direction": "reverse", "source_marker": "leading_space", "prompt": "手里有优质业务线索时，我会优先留给自己完成个人指标。"},
    {"id": "L11", "kind": "workplace_likert", "response_type": "likert6", "dimension": "协作共益", "direction": "reverse", "source_marker": "leading_space", "prompt": "和合作方存在利益分歧时，我会坚守我方利益。"},

    {"id": "S01", "kind": "workplace_choice", "response_type": "single_choice", "dimension": "情境证据", "prompt": "和客户洽谈合作时，适度侧重突出项目优势可以大幅提高签约概率，你一般会怎么处理？", "options": [{"value":"A","label":"完整客观说明全部现状，不刻意放大亮点"},{"value":"B","label":"客观基础上提炼核心优势，不编造虚假内容"},{"value":"C","label":"根据客户关注点灵活调整表达侧重点"},{"value":"D","label":"优先促成签约，细节问题后续再沟通协商"}]},
    {"id": "S02", "kind": "workplace_choice", "response_type": "single_choice", "dimension": "情境证据", "prompt": "你手里有一批优质客户线索，同期新人距离业绩指标差距很大，你更倾向？", "options": [{"value":"A","label":"线索自主跟进，优先完成个人考核目标"},{"value":"B","label":"拆分少量线索，陪同新人一起对接学习"},{"value":"C","label":"大部分线索移交新人，自己维护存量客户"},{"value":"D","label":"先留存线索，等自身指标达标后再分配"}]},
    {"id": "S03", "kind": "workplace_choice", "response_type": "single_choice", "dimension": "情境证据", "prompt": "季度重点项目推进期间，连续几周需要延长工作时间、偶尔周末半天处理事务，你的真实感受是？", "options": [{"value":"A","label":"可以全程配合，主动跟进核心工作"},{"value":"B","label":"短期配合没问题，长期持续会产生压力"},{"value":"C","label":"仅在紧急节点配合，日常尽量保持固定作息"},{"value":"D","label":"优先保证休息时间，尽量不占用私人时段"}]},
    {"id": "S04", "kind": "workplace_choice", "response_type": "single_choice", "dimension": "情境证据", "prompt": "公司统一安排全员线下门店实操学习1个月，不少同事认为浪费原有工作经验，你的看法是？", "options": [{"value":"A","label":"主动参与，认为能加深对业务底层逻辑的理解"},{"value":"B","label":"可以配合，但更希望专注原有擅长的工作"},{"value":"C","label":"选择性参与，只学习和自身岗位相关内容"},{"value":"D","label":"内心比较抵触，希望直接回到原有本职工作"}]},

    {"id": "W01", "kind": "workplace_choice", "response_type": "single_choice", "dimension": "情境证据", "prompt": "接手一个目标明确但做法开放的新项目时，你通常最先关注什么？", "options": [{"value":"A","label":"先了解它与后续业务可能形成的长期价值","dimension":"长期投入"},{"value":"B","label":"先把交付边界、责任和确认方式说清楚","dimension":"诚信履约"},{"value":"C","label":"先找到一个能快速试跑的切入点","dimension":"节奏适应"},{"value":"D","label":"先补齐完成它所需要的新知识","dimension":"专业成长"}]},
    {"id": "W07", "kind": "workplace_choice", "response_type": "single_choice", "dimension": "情境证据", "prompt": "原计划被外部变化打断时，你通常最先重建什么？", "options": [{"value":"A","label":"当前优先级和下一次检查节点","dimension":"节奏适应"},{"value":"B","label":"对相关人的新承诺和边界","dimension":"诚信履约"},{"value":"C","label":"仍值得保留的长期目标","dimension":"长期投入"},{"value":"D","label":"变化背后需要补上的专业判断","dimension":"专业成长"}]},
    {"id": "W08", "kind": "workplace_choice", "response_type": "single_choice", "dimension": "情境证据", "prompt": "跨部门合作进展缓慢时，你更可能先从哪里推动？", "options": [{"value":"A","label":"把共同收益和各自困难重新说清楚","dimension":"协作共益"},{"value":"B","label":"确认对方服务的对象和真实优先级","dimension":"客户意识"},{"value":"C","label":"拆出一个双方都能立即推进的小步骤","dimension":"节奏适应"},{"value":"D","label":"重新确认各自承诺的交付时间与形式","dimension":"诚信履约"}]},
    {"id": "W13", "kind": "workplace_choice", "response_type": "single_choice", "dimension": "情境证据", "prompt": "你收到一个表达含糊的需求时，通常首先想弄清什么？", "options": [{"value":"A","label":"对方实际要完成的任务和使用情境","dimension":"客户意识"},{"value":"B","label":"相关人之间怎样分工和传递信息","dimension":"协作共益"},{"value":"C","label":"这件事未来是否还会重复发生","dimension":"长期投入"},{"value":"D","label":"当前最小可验证结果是什么","dimension":"节奏适应"}]},
    {"id": "W17", "kind": "workplace_choice", "response_type": "single_choice", "dimension": "情境证据", "prompt": "团队成员的做法与你不同，但结果暂时都可接受时，你更倾向怎么处理？", "options": [{"value":"A","label":"比较哪种方式更适合未来重复使用","dimension":"长期投入"},{"value":"B","label":"交流彼此方法，寻找可以互相补充的部分","dimension":"协作共益"},{"value":"C","label":"观察哪种方式更符合专业规律","dimension":"专业成长"},{"value":"D","label":"保留弹性，以当前交付节奏为先","dimension":"节奏适应"}]},

    {"id": "C01", "kind": "credibility", "response_type": "likert6", "dimension": "可信度", "direction": "positive", "check_type": "consistency", "compare_question_id": "P19", "compare_direction": "positive", "prompt": "开始处理边界不清的任务前，我通常会先整理出一个大致框架。"},
