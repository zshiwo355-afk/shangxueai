  "questions": [
    {"id": "P01", "kind": "personality", "response_type": "likert6", "dimension": "宜人性", "direction": "positive", "norm_core": true, "prompt": "我觉得大部分人基本上是心怀善意的。"},
    {"id": "P02", "kind": "personality", "response_type": "likert6", "dimension": "外向性", "direction": "reverse", "norm_core": true, "prompt": "我对人多的聚会感到乏味。"},
    {"id": "P03", "kind": "personality", "response_type": "likert6", "dimension": "开放性", "direction": "positive", "norm_core": true, "prompt": "我是个勇于冒险、突破常规的人。"},
    {"id": "P04", "kind": "personality", "response_type": "likert6", "dimension": "开放性", "direction": "positive", "norm_core": true, "prompt": "我喜欢冒险。"},
    {"id": "P05", "kind": "personality", "response_type": "likert6", "dimension": "外向性", "direction": "reverse", "norm_core": true, "prompt": "我尽量避免参加人多的聚会和嘈杂的环境。"},
    {"id": "P06", "kind": "personality", "response_type": "likert6", "dimension": "尽责性", "direction": "positive", "norm_core": true, "prompt": "我喜欢一开头就把事情计划好。"},
    {"id": "P07", "kind": "personality", "response_type": "likert6", "dimension": "开放性", "direction": "positive", "norm_core": true, "prompt": "我身上具有别人没有的冒险精神。"},
    {"id": "P08", "kind": "personality", "response_type": "likert6", "dimension": "宜人性", "direction": "positive", "norm_core": true, "prompt": "虽然社会上有些骗子，但我觉得大部分人还是可信的。"},
    {"id": "P09", "kind": "personality", "response_type": "likert6", "dimension": "尽责性", "direction": "positive", "norm_core": true, "prompt": "我工作或学习很勤奋。"},
    {"id": "P10", "kind": "personality", "response_type": "likert6", "dimension": "情绪稳定性", "direction": "reverse", "norm_core": true, "prompt": "我常担忧一些无关紧要的事情。"},
    {"id": "P11", "kind": "personality", "response_type": "likert6", "dimension": "情绪稳定性", "direction": "reverse", "norm_core": true, "prompt": "我常常感到内心不踏实。"},
    {"id": "P12", "kind": "personality", "response_type": "likert6", "dimension": "情绪稳定性", "direction": "reverse", "norm_core": true, "prompt": "我常担心有什么不好的事情要发生。"},
    {"id": "P13", "kind": "personality", "response_type": "likert6", "dimension": "宜人性", "direction": "positive", "norm_core": true, "prompt": "尽管社会存在一些阴暗面，我仍相信人性总的来说是善良的。"},
    {"id": "P14", "kind": "personality", "response_type": "likert6", "dimension": "外向性", "direction": "positive", "norm_core": true, "prompt": "我喜欢参加社交与娱乐聚会。"},
    {"id": "P15", "kind": "personality", "response_type": "likert6", "dimension": "尽责性", "direction": "positive", "norm_core": true, "prompt": "做事讲究逻辑和条理是我的一个特点。"},

    {"id": "P16", "kind": "personality_context", "response_type": "likert6", "dimension": "开放性", "direction": "positive", "prompt": "面对一个熟悉的问题，我会有兴趣试试与惯常做法不同的解释。"},
    {"id": "P17", "kind": "personality_context", "response_type": "likert6", "dimension": "开放性", "direction": "reverse", "prompt": "如果现有办法还能用，我通常不太想为新的可能性分散注意力。"},
    {"id": "P18", "kind": "personality_context", "response_type": "likert6", "dimension": "开放性", "direction": "positive", "prompt": "我容易被跨领域的观点吸引，即使它暂时与工作无关。"},
    {"id": "P19", "kind": "personality_context", "response_type": "likert6", "dimension": "尽责性", "direction": "positive", "prompt": "任务还很模糊时，我倾向先搭一个可调整的结构再开始。"},
    {"id": "P20", "kind": "personality_context", "response_type": "likert6", "dimension": "尽责性", "direction": "reverse", "prompt": "临近期限带来的压力，常常比提前安排更能让我进入状态。"},
    {"id": "P21", "kind": "personality_context", "response_type": "likert6", "dimension": "尽责性", "direction": "positive", "prompt": "完成主要部分后，我通常还会留意容易被忽略的收尾事项。"},
    {"id": "P22", "kind": "personality_context", "response_type": "likert6", "dimension": "外向性", "direction": "positive", "prompt": "讨论刚开始时，我往往愿意先抛出一个不成熟的想法。"},
    {"id": "P23", "kind": "personality_context", "response_type": "likert6", "dimension": "外向性", "direction": "reverse", "prompt": "长时间与多人互动后，我通常需要独处才能恢复精力。"},
    {"id": "P24", "kind": "personality_context", "response_type": "likert6", "dimension": "外向性", "direction": "positive", "prompt": "进入陌生群体时，我一般不会等很久才开始交流。"},
    {"id": "P25", "kind": "personality_context", "response_type": "likert6", "dimension": "宜人性", "direction": "positive", "prompt": "分歧发生时，我会自然地先理解对方为什么那样判断。"},
    {"id": "P26", "kind": "personality_context", "response_type": "likert6", "dimension": "宜人性", "direction": "reverse", "prompt": "当结论很重要时，我不太介意让讨论显得尖锐。"},
    {"id": "P27", "kind": "personality_context", "response_type": "likert6", "dimension": "宜人性", "direction": "positive", "prompt": "即使别人表达得不够好，我也会尝试找出其中合理的部分。"},
    {"id": "P28", "kind": "personality_context", "response_type": "likert6", "dimension": "情绪稳定性", "direction": "positive", "prompt": "计划突然改变时，我通常能较快把注意力转到下一步。"},
    {"id": "P29", "kind": "personality_context", "response_type": "likert6", "dimension": "情绪稳定性", "direction": "reverse", "prompt": "一次不顺利的互动，容易在之后很久占据我的注意力。"},
    {"id": "P30", "kind": "personality_context", "response_type": "likert6", "dimension": "情绪稳定性", "direction": "positive", "prompt": "信息不完整时，我通常可以先保留判断，而不是反复设想最坏结果。"},

    {"id": "W01", "kind": "workplace", "response_type": "most_least", "prompt": "接手一个目标明确但做法开放的新项目时，你通常最先关注什么？", "options": [{"value":"A","label":"先了解它与后续业务可能形成的长期价值","dimension":"长期投入"},{"value":"B","label":"先把交付边界、责任和确认方式说清楚","dimension":"诚信履约"},{"value":"C","label":"先找到一个能快速试跑的切入点","dimension":"节奏适应"},{"value":"D","label":"先补齐完成它所需要的新知识","dimension":"专业成长"}]},
    {"id": "W02", "kind": "workplace", "response_type": "most_least", "prompt": "客户提出一个超出原范围、但确实有价值的要求时，你更可能先怎么处理？", "options": [{"value":"A","label":"追问真实使用场景，确认价值来自哪里","dimension":"客户意识"},{"value":"B","label":"拉上相关同事一起评估可行路径","dimension":"协作共益"},{"value":"C","label":"回到原约定，说明新增部分会改变什么","dimension":"诚信履约"},{"value":"D","label":"先做一个低成本验证，看看问题是否真实存在","dimension":"节奏适应"}]},
    {"id": "W03", "kind": "workplace", "response_type": "most_least", "prompt": "工作量突然增加，而现有方式开始吃力时，你通常会优先做什么？", "options": [{"value":"A","label":"重排节奏，让最关键的交付先稳定下来","dimension":"节奏适应"},{"value":"B","label":"研究有没有更专业、更可复用的处理方式","dimension":"专业成长"},{"value":"C","label":"与上下游同步压力和可调整空间","dimension":"协作共益"},{"value":"D","label":"判断这段投入是否值得沉淀成长期能力","dimension":"长期投入"}]},
    {"id": "W04", "kind": "workplace", "response_type": "most_least", "prompt": "你发现一个已交付结果存在小偏差，暂时没有造成影响，你更可能先做什么？", "options": [{"value":"A","label":"核对承诺标准，判断是否需要主动更正","dimension":"诚信履约"},{"value":"B","label":"回看形成偏差的知识或方法缺口","dimension":"专业成长"},{"value":"C","label":"确认客户或使用方真正会受到什么影响","dimension":"客户意识"},{"value":"D","label":"找熟悉这部分的人快速交叉确认","dimension":"协作共益"}]},
    {"id": "W05", "kind": "workplace", "response_type": "most_least", "prompt": "团队在短期结果和长期建设之间摇摆时，你更容易从哪个角度切入？", "options": [{"value":"A","label":"先看哪项选择能积累可复用的资产","dimension":"长期投入"},{"value":"B","label":"先看眼下窗口期是否允许调整节奏","dimension":"节奏适应"},{"value":"C","label":"先看哪项选择更贴近真实使用者","dimension":"客户意识"},{"value":"D","label":"先组织相关成员把各自约束摊开","dimension":"协作共益"}]},
    {"id": "W06", "kind": "workplace", "response_type": "most_least", "prompt": "遇到一个没有成熟答案的专业问题时，你通常更接近哪种起步方式？", "options": [{"value":"A","label":"先查可靠资料并建立判断框架","dimension":"专业成长"},{"value":"B","label":"先明确在什么时间点交付到什么程度","dimension":"诚信履约"},{"value":"C","label":"先问清最终使用者最在意的结果","dimension":"客户意识"},{"value":"D","label":"先找能互补的人一起拆解","dimension":"协作共益"}]},
    {"id": "W07", "kind": "workplace", "response_type": "most_least", "prompt": "原计划被外部变化打断时，你通常最先重建什么？", "options": [{"value":"A","label":"当前优先级和下一次检查节点","dimension":"节奏适应"},{"value":"B","label":"对相关人的新承诺和边界","dimension":"诚信履约"},{"value":"C","label":"仍值得保留的长期目标","dimension":"长期投入"},{"value":"D","label":"变化背后需要补上的专业判断","dimension":"专业成长"}]},
    {"id": "W08", "kind": "workplace", "response_type": "most_least", "prompt": "跨部门合作进展缓慢时，你更可能先从哪里推动？", "options": [{"value":"A","label":"把共同收益和各自困难重新说清楚","dimension":"协作共益"},{"value":"B","label":"确认对方服务的对象和真实优先级","dimension":"客户意识"},{"value":"C","label":"拆出一个双方都能立即推进的小步骤","dimension":"节奏适应"},{"value":"D","label":"重新确认各自承诺的交付时间与形式","dimension":"诚信履约"}]},
    {"id": "W09", "kind": "workplace", "response_type": "most_least", "prompt": "一项重复工作已经可以完成，但效率一般，你通常更在意什么？", "options": [{"value":"A","label":"是否值得沉淀为长期稳定的流程","dimension":"长期投入"},{"value":"B","label":"是否有更专业的工具或方法值得掌握","dimension":"专业成长"},{"value":"C","label":"优化后会不会真正改善使用体验","dimension":"客户意识"},{"value":"D","label":"能否让更多协作者减少重复负担","dimension":"协作共益"}]},
    {"id": "W10", "kind": "workplace", "response_type": "most_least", "prompt": "负责人临时要求提前交付，你通常先做哪类判断？", "options": [{"value":"A","label":"哪些范围可以调整而不破坏核心承诺","dimension":"诚信履约"},{"value":"B","label":"怎样重新组织步骤以适应新节奏","dimension":"节奏适应"},{"value":"C","label":"提前交付对最终使用方究竟解决什么问题","dimension":"客户意识"},{"value":"D","label":"这次变化是否影响后续持续投入的价值","dimension":"长期投入"}]},
    {"id": "W11", "kind": "workplace", "response_type": "most_least", "prompt": "同事对你的方案提出强烈异议时，你更可能先做什么？", "options": [{"value":"A","label":"请对方一起明确分歧所依据的事实","dimension":"协作共益"},{"value":"B","label":"检查自己的专业依据是否有缺口","dimension":"专业成长"},{"value":"C","label":"确认方案对使用者的影响是否被忽略","dimension":"客户意识"},{"value":"D","label":"说明哪些约定不能在未确认时直接改变","dimension":"诚信履约"}]},
    {"id": "W12", "kind": "workplace", "response_type": "most_least", "prompt": "同时出现三件重要但期限不同的任务时，你更可能按什么来排序？", "options": [{"value":"A","label":"按当前影响和依赖关系动态调整","dimension":"节奏适应"},{"value":"B","label":"按已经对外作出的明确承诺","dimension":"诚信履约"},{"value":"C","label":"按对长期目标的持续贡献","dimension":"长期投入"},{"value":"D","label":"按最能提升关键能力的机会","dimension":"专业成长"}]},
    {"id": "W13", "kind": "workplace", "response_type": "most_least", "prompt": "你收到一个表达含糊的需求时，通常首先想弄清什么？", "options": [{"value":"A","label":"对方实际要完成的任务和使用情境","dimension":"客户意识"},{"value":"B","label":"相关人之间怎样分工和传递信息","dimension":"协作共益"},{"value":"C","label":"这件事未来是否还会重复发生","dimension":"长期投入"},{"value":"D","label":"当前最小可验证结果是什么","dimension":"节奏适应"}]},
    {"id": "W14", "kind": "workplace", "response_type": "most_least", "prompt": "项目复盘时，你最自然会追问哪类问题？", "options": [{"value":"A","label":"哪些承诺与实际结果出现了偏差","dimension":"诚信履约"},{"value":"B","label":"哪些判断体现了专业能力的不足","dimension":"专业成长"},{"value":"C","label":"协作中哪些信息本可以更早共享","dimension":"协作共益"},{"value":"D","label":"最后的结果是否真正解决了用户问题","dimension":"客户意识"}]},
    {"id": "W15", "kind": "workplace", "response_type": "most_least", "prompt": "一个项目短期回报不明显，但可能形成新能力时，你更可能依据什么决定是否继续？", "options": [{"value":"A","label":"它是否与未来方向形成持续积累","dimension":"长期投入"},{"value":"B","label":"团队是否能共同承担探索成本","dimension":"协作共益"},{"value":"C","label":"能否设计更短周期的验证节点","dimension":"节奏适应"},{"value":"D","label":"它是否解决了真实而稳定的需求","dimension":"客户意识"}]},
    {"id": "W16", "kind": "workplace", "response_type": "most_least", "prompt": "你需要在不熟悉的领域代表团队作出说明时，会优先准备什么？", "options": [{"value":"A","label":"事实边界，以及哪些内容尚不能承诺","dimension":"诚信履约"},{"value":"B","label":"核心概念和专业证据链","dimension":"专业成长"},{"value":"C","label":"听众最可能关心的实际问题","dimension":"客户意识"},{"value":"D","label":"现场变化时的替代节奏与顺序","dimension":"节奏适应"}]},
    {"id": "W17", "kind": "workplace", "response_type": "most_least", "prompt": "团队成员的做法与你不同，但结果暂时都可接受时，你更倾向怎么处理？", "options": [{"value":"A","label":"比较哪种方式更适合未来重复使用","dimension":"长期投入"},{"value":"B","label":"交流彼此方法，寻找可以互相补充的部分","dimension":"协作共益"},{"value":"C","label":"观察哪种方式更符合专业规律","dimension":"专业成长"},{"value":"D","label":"保留弹性，以当前交付节奏为先","dimension":"节奏适应"}]},
    {"id": "W18", "kind": "workplace", "response_type": "most_least", "prompt": "客户对结果满意，但你知道过程里有一些偶然因素时，你更可能做什么？", "options": [{"value":"A","label":"说明结果边界，避免形成超过事实的预期","dimension":"诚信履约"},{"value":"B","label":"把偶然因素转化成可重复的专业方法","dimension":"专业成长"},{"value":"C","label":"继续观察客户后续使用是否仍然顺畅","dimension":"客户意识"},{"value":"D","label":"与团队共享这次过程中的不确定性","dimension":"协作共益"}]},
    {"id": "W19", "kind": "workplace", "response_type": "most_least", "prompt": "你发现一项工作经常被临时需求打断时，更想先改变什么？", "options": [{"value":"A","label":"建立能容纳变化的工作节奏","dimension":"节奏适应"},{"value":"B","label":"重新确认谁可以改变哪些承诺","dimension":"诚信履约"},{"value":"C","label":"识别临时需求背后的共同用户问题","dimension":"客户意识"},{"value":"D","label":"建立可长期减少中断的基础能力","dimension":"长期投入"}]},
    {"id": "W20", "kind": "workplace", "response_type": "most_least", "prompt": "资源有限，只能优先改善一个环节时，你最容易支持哪类方案？", "options": [{"value":"A","label":"能明显提升团队配合效率的方案","dimension":"协作共益"},{"value":"B","label":"能补强关键专业短板的方案","dimension":"专业成长"},{"value":"C","label":"能改善核心客户体验的方案","dimension":"客户意识"},{"value":"D","label":"能形成长期复利的基础方案","dimension":"长期投入"}]},

